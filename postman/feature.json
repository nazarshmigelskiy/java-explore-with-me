    {
      "name": "Создание комментария",
      "item": [
        {
          "name": "Добавление комментария к опубликованному событию",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ответ должен содержать код статуса 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Комментарий содержит поля: id, text, eventId, author, createdOn, updatedOn\", function () {",
                  "    pm.expect(body).to.include.all.keys('id', 'text', 'eventId', 'author', 'createdOn', 'updatedOn');",
                  "});",
                  "pm.test(\"Данные комментария соответствуют запросу\", function () {",
                  "    pm.expect(body.text).to.equal(\"Отличное событие, обязательно приду\");",
                  "    pm.expect(body.eventId).to.equal(Number(pm.collectionVariables.get(\"eventId\")));",
                  "    pm.expect(body.author.id).to.equal(Number(pm.collectionVariables.get(\"authorId\")));",
                  "    pm.expect(body.updatedOn).to.be.null;",
                  "});",
                  "pm.collectionVariables.set(\"commentId\", pm.response.json().id);"
                ]
              }
            }
          ],
